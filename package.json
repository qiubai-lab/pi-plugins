{
  "name": "@qiubai-lab/pi-plugins",
  "version": "0.3.0",
  "private": true,
  "description": "Private Pi extension collection",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/qiubai-lab/pi-plugins.git"
  },
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extensions/*/index.ts",
      "./node_modules/betterwright/dist/src/pi-extension.js",
      "./node_modules/pi-lens/dist/index.js",
      "./node_modules/pi-web-access/index.ts",
      "./node_modules/pi-subagents/index.ts"
    ],
    "skills": [
      "./node_modules/pi-lens/skills",
      "./node_modules/pi-subagents/skills"
    ],
    "prompts": [
      "./node_modules/pi-subagents/prompts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "dependencies": {
    "betterwright": "latest",
    "pi-lens": "latest",
    "pi-subagents": "latest",
    "pi-web-access": "latest"
  },
  "bundledDependencies": [
    "betterwright",
    "pi-lens",
    "pi-subagents",
    "pi-web-access"
  ]
}
